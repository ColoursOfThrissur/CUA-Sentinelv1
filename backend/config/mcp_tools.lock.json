{
  "apps": {
    "blender": {
      "server": {
        "command": "uvx",
        "args": [
          "mcp-for-blender"
        ],
        "env_allowlist": [
          "SYSTEMROOT",
          "TEMP",
          "TMP",
          "PATH",
          "USERPROFILE",
          "APPDATA",
          "LOCALAPPDATA",
          "PYTHONIOENCODING",
          "PATHEXT"
        ]
      },
      "tools": {
        "execute_blender_code": {
          "schema_sha256": "bec31364a19bfcd0fcd3225a8b78742a7655279f0fd0f3710945b0b8846e6170",
          "description": "Internal execution bridge for validated Blender Python templates",
          "side_effect": "act",
          "risk_level": "L3",
          "returns_untrusted": true,
          "reads_private_data": false,
          "egress": false,
          "taint_deny": true,
          "taint_safe": false,
          "deny_all": true,
          "internal_only": true,
          "timeout_seconds": 60,
          "allowed_agents": []
        },
        "get_scene_info": {
          "schema_sha256": "da93badde85b6eba8a4b6ac5b79d5e5938c08266f371cfba1df451068a75d28f",
          "description": "Query high-level metadata about the current Blender scene",
          "side_effect": "read",
          "risk_level": "L0",
          "returns_untrusted": true,
          "reads_private_data": false,
          "egress": false,
          "taint_deny": false,
          "taint_safe": false,
          "deny_all": false,
          "internal_only": true,
          "timeout_seconds": 15,
          "allowed_agents": [
            "blender_agent"
          ]
        },
        "get_viewport_screenshot": {
          "schema_sha256": "508f772c7bbabf575d1b8ad9b41998fe0a381b46e8816af2bd5bc1360723dbf7",
          "description": "Capture current 3D viewport screenshot for verification",
          "side_effect": "read",
          "risk_level": "L0",
          "returns_untrusted": true,
          "reads_private_data": false,
          "egress": false,
          "taint_deny": false,
          "taint_safe": false,
          "deny_all": false,
          "internal_only": true,
          "timeout_seconds": 30,
          "allowed_agents": [
            "blender_agent"
          ]
        }
      }
    }
  }
}
